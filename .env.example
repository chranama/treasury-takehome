# Application mode: development, test, or production.
TREASURY_APP_ENV=development

# Local runtime paths. Relative paths resolve from the repository root.
TREASURY_DATABASE_PATH=.data/treasury.sqlite3
TREASURY_TEMP_DIR=.data/tmp
TREASURY_FRONTEND_DIST_PATH=frontend/dist

# Development defaults to a named, non-network fake scenario.
TREASURY_EXTRACTION_BACKEND=fake
TREASURY_FAKE_EXTRACTION_SCENARIO=clear_matching_label
TREASURY_LIVE_EXTRACTION_ENABLED=false

# Required only when the hosted adapter is explicitly enabled.
TREASURY_OPENAI_API_KEY=
TREASURY_OPENAI_MODEL=gpt-5.6-luna
TREASURY_OPENAI_IMAGE_DETAIL=high
# Standard is the evaluated deployment default; set to fast only for an explicit experiment.
TREASURY_OPENAI_SERVICE_TIER=default
TREASURY_OPENAI_MAX_OUTPUT_TOKENS=1000
TREASURY_OPENAI_TRANSIENT_RETRIES=1
TREASURY_EXTRACTION_TIMEOUT_SECONDS=12

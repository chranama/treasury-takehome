# Copy to /Users/chranama-server/treasury-takehome-data/config/treasury.env and chmod 600.
# The launchd wrapper supplies production mode and all application data paths.

TREASURY_EXTRACTION_BACKEND=openai
TREASURY_LIVE_EXTRACTION_ENABLED=false
TREASURY_OPENAI_API_KEY=
TREASURY_OPENAI_MODEL=gpt-5.6-luna
TREASURY_OPENAI_IMAGE_DETAIL=high
TREASURY_OPENAI_SERVICE_TIER=default
TREASURY_OPENAI_MAX_OUTPUT_TOKENS=1000
TREASURY_OPENAI_TRANSIENT_RETRIES=1
TREASURY_EXTRACTION_TIMEOUT_SECONDS=12

# Add the private positive values below only when live extraction is deliberately enabled.
# Never commit, print, or copy their deployed values into operator evidence.
# TREASURY_LIVE_DAILY_ATTEMPT_LIMIT=<private positive integer>
# TREASURY_LIVE_CUMULATIVE_COST_LIMIT_USD=<private positive dollar amount>
# TREASURY_LIVE_ATTEMPT_RESERVATION_USD=<private positive dollar amount>
# TREASURY_LIVE_SOURCE_WINDOW_SECONDS=<private positive integer>
# TREASURY_LIVE_SOURCE_MAX_SUBMISSIONS=<private positive integer>

# Keep false until the only public path is the configured Cloudflare tunnel.
TREASURY_TRUST_CLOUDFLARE_CLIENT_IP=false
